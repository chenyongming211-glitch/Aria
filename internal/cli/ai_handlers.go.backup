package cli

import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"sync"
	"time"

	"aria/pkg/llm"
	"aria/pkg/logging"
	"aria/pkg/mcp"
	"aria/pkg/controllerstorage"
)

// LogBroadcaster manages SSE connections for streaming logs
type LogBroadcaster struct {
	mu       sync.RWMutex
	channels map[string]chan string
}

var logBroadcaster = &LogBroadcaster{
	channels: make(map[string]chan string),
}

// SendLog sends a log message to a specific session
func (b *LogBroadcaster) SendLog(sessionID, message string) {
	b.mu.RLock()
	ch, ok := b.channels[sessionID]
	b.mu.RUnlock()

	if ok {
		select {
		case ch <- message:
		default:
			// Channel full, skip
		}
	}
}

// Subscribe creates a new SSE connection for a session
func (b *LogBroadcaster) Subscribe(sessionID string) chan string {
	b.mu.Lock()
	defer b.mu.Unlock()

	ch := make(chan string, 100)
	b.channels[sessionID] = ch
	return ch
}

// Unsubscribe removes a session's SSE connection
func (b *LogBroadcaster) Unsubscribe(sessionID string) {
	b.mu.Lock()
	defer b.mu.Unlock()

	if ch, ok := b.channels[sessionID]; ok {
		close(ch)
		delete(b.channels, sessionID)
	}
}

// AIConfig holds AI-related configuration
type AIConfig struct {
	Enabled      bool   `yaml:"enabled"`
	APIKey       string `yaml:"api_key"`
	BaseURL      string `yaml:"base_url"`
	Model        string `yaml:"model"`
	MCPBinPath   string `yaml:"mcp_bin_path"`
	SystemPrompt string `yaml:"system_prompt"`
}

// AIService represents the AI service
type AIService struct {
	config     *AIConfig
	llm        *llm.Adapter
	mcpHost    *mcp.Host
	registry   *mcp.Registry
	sessions   map[string]*llm.Session
	sessionsMu sync.RWMutex
	logger     *logging.Logger
	store      *controllerstorage.Storage
}

// NewAIService creates a new AI service
func NewAIService(config *AIConfig, logger *logging.Logger, store *controllerstorage.Storage) *AIService {
	registry := mcp.DefaultTools(logger, store)

	return &AIService{
		config:   config,
		registry: registry,
		sessions: make(map[string]*llm.Session),
		logger:   logger,
		store:    store,
	}
}

// Start starts the AI service
func (s *AIService) Start(ctx context.Context) error {
	if !s.config.Enabled {
		s.logger.Info("AI service disabled")
		return nil
	}

	// Initialize LLM adapter
	s.llm = llm.NewAdapter(&llm.Config{
		APIKey:     s.config.APIKey,
		BaseURL:    s.config.BaseURL,
		Model:      s.config.Model,
		MaxTokens:  4096,
		Temperature: 0.7,
	})

	// Initialize MCP Host (optional - can work without it)
	if s.config.MCPBinPath != "" {
		s.mcpHost = mcp.NewHost(&mcp.HostConfig{
			MCPBinPath: s.config.MCPBinPath,
			Timeout:    30 * time.Second,
		}, s.registry)

		if err := s.mcpHost.Start(ctx); err != nil {
			s.logger.Warn("Failed to start MCP host: %v, continuing without tools", err)
		} else {
			s.logger.Info("MCP host started")
			// 启动 MCP 自愈机制 - 每 10 秒检查一次，崩溃后 5 秒内重启
			s.mcpHost.StartHealthCheck(ctx, 10*time.Second, func() {
				s.logger.Info("MCP host restarted due to crash")
			})
		}
	}

	s.logger.Info("AI service started")
	return nil
}

// Stop stops the AI service
func (s *AIService) Stop() {
	if s.mcpHost != nil {
		s.mcpHost.Stop()
	}
	s.logger.Info("AI service stopped")
}

// HandleAIChat handles the AI chat request
func (s *AIService) HandleAIChat(w http.ResponseWriter, r *http.Request) {
	var finalResp *llm.ChatResponse

	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	if !s.config.Enabled {
		http.Error(w, "AI service not enabled", http.StatusServiceUnavailable)
		return
	}

	var req struct {
		Message   string                 `json:"message"`
		SessionID string                 `json:"session_id,omitempty"`
		Tools     bool                   `json:"tools,omitempty"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]interface{}{
			"status":  "error",
			"message": "Invalid request: " + err.Error(),
		})
		return
	}

	// Get or create session
	sessionID := req.SessionID
	if sessionID == "" {
		sessionID = generateSessionID()
	}

	session := s.getOrCreateSession(sessionID)
	session.AddMessage("user", req.Message)

	// Get tools from registry
	var tools []llm.Tool
	if req.Tools && s.mcpHost != nil {
		mcpTools := s.registry.ListTools()
		tools = convertMCPToLLMTools(mcpTools)
	}

	// Call LLM
	resp, err := s.llm.Chat(context.Background(), session.Messages, tools)
	if err != nil {
		s.logger.Error("LLM call failed: %v", err)
		http.Error(w, fmt.Sprintf("LLM call failed: %v", err), http.StatusInternalServerError)
		return
	}

	if len(resp.Choices) == 0 {
		http.Error(w, "No response from LLM", http.StatusInternalServerError)
		return
	}

	choice := resp.Choices[0].Message

	// Check for tool calls
	if len(choice.ToolCalls) > 0 {
		// Process tool calls
		for _, tc := range choice.ToolCalls {
			// Handle arguments - could be JSON object or string
			argsStr := string(tc.Function.Arguments)
			session.AddToolCall(tc.ID, tc.Function.Name, argsStr)

			// Execute tool - parse arguments
			var args map[string]interface{}
			// First try direct parse
			if err := json.Unmarshal(tc.Function.Arguments, &args); err != nil {
				// If fails, the arguments might be a string representation of JSON
				// Try to parse as string first
				var argsStrDirect string
				if err2 := json.Unmarshal(tc.Function.Arguments, &argsStrDirect); err2 == nil {
					// It's a string, parse that string as JSON
					if err3 := json.Unmarshal([]byte(argsStrDirect), &args); err3 != nil {
						// If that also fails, use empty args
						s.logger.Warn("Using empty args for tool %s: %v", tc.Function.Name, err3)
						args = make(map[string]interface{})
					}
				} else {
					// Not a string either, use empty args
					args = make(map[string]interface{})
				}
			}

			var result *mcp.ToolResult
			var toolErr error

			// Try local registry first
			result, toolErr = s.registry.CallTool(tc.Function.Name, args)

			// If not found in registry and MCP host is available, try MCP
			if toolErr != nil && s.mcpHost != nil {
				result, toolErr = s.mcpHost.CallTool(context.Background(), tc.Function.Name, args)
			}

			var resultContent string
			if toolErr != nil {
				resultContent = fmt.Sprintf(`{"error": "%v"}`, toolErr)
			} else if result != nil {
				resultContent = toJSON(result)
			} else {
				resultContent = `{"result": "ok"}`
			}

			session.AddToolResult(tc.ID, resultContent)
		}

		// Get final response from LLM (must include tools for tool call context)
		finalResp, err := s.llm.Chat(context.Background(), session.Messages, tools)
		if err != nil {
			s.logger.Error("Final LLM call failed: %v", err)
			http.Error(w, fmt.Sprintf("Final LLM call failed: %v", err), http.StatusInternalServerError)
			return
		}

		if len(finalResp.Choices) > 0 {
			session.AddMessage("assistant", finalResp.Choices[0].Message.Content)
		}
	} else {
		session.AddMessage("assistant", choice.Content)
	}

	// Build response - include tool_calls array if present
	// 如果有工具调用，使用最终 LLM 生成的总结；否则用原始回复
	responseMessage := choice.Content
	if len(choice.ToolCalls) > 0 && finalResp != nil && len(finalResp.Choices) > 0 {
		responseMessage = finalResp.Choices[0].Message.Content
	}

	response := map[string]interface{}{
		"session_id": sessionID,
		"message":    responseMessage,
	}

	// Add tool_calls if present (for confirmation)
	if len(choice.ToolCalls) > 0 {
		var toolCalls []map[string]interface{}
		var toolName string
		for _, tc := range choice.ToolCalls {
			toolName = tc.Function.Name
			toolCalls = append(toolCalls, map[string]interface{}{
				"id": tc.ID,
				"type": tc.Type,
				"function": map[string]interface{}{
					"name":      tc.Function.Name,
					"arguments": tc.Function.Arguments,
				},
			})
		}
		response["tool_calls"] = toolCalls
		// 判断是否需要确认（敏感工具需要确认）
		response["needs_confirm"] = mcp.IsSensitive(toolName)
	}

	// 记录审计日志
	go s.saveAuditLog(sessionID, req.Message, choice.Content, "", nil, "", "success", 0)

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// HandleAIConfirm handles tool confirmation
func (s *AIService) HandleAIConfirm(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	var req struct {
		SessionID string                 `json:"session_id"`
		ToolName  string                 `json:"tool_name"`
		Params    map[string]interface{} `json:"params"`
		Confirmed bool                   `json:"confirmed"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]interface{}{
			"status":  "error",
			"message": "Invalid request: " + err.Error(),
		})
		return
	}

	// Check if tool requires confirmation (only for sensitive tools)
	if mcp.IsSensitive(req.ToolName) && !req.Confirmed {
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]interface{}{
			"status":   "cancelled",
			"message":  "Operation cancelled by user",
		})
		return
	}

	// Execute the tool
	startTime := time.Now()

	// 发送开始执行日志
	logBroadcaster.SendLog(req.SessionID, fmt.Sprintf(`{"type": "log", "level": "info", "message": "Starting execution of %s...", "timestamp": "%s"}`, req.ToolName, time.Now().Format(time.RFC3339)))

	result, err := s.registry.CallTool(req.ToolName, req.Params)
	execTimeMs := int(time.Since(startTime).Milliseconds())

	var resultStr string
	var status string
	if err != nil {
		resultStr = fmt.Sprintf(`{"error": "%v"}`, err)
		status = "error"
		// 发送错误日志
		logBroadcaster.SendLog(req.SessionID, fmt.Sprintf(`{"type": "log", "level": "error", "message": "Execution failed: %v", "timestamp": "%s"}`, err, time.Now().Format(time.RFC3339)))
	} else {
		resultStr = toJSON(result)
		status = "success"
		// 发送成功日志
		logBroadcaster.SendLog(req.SessionID, fmt.Sprintf(`{"type": "log", "level": "success", "message": "Execution completed in %dms", "timestamp": "%s"}`, execTimeMs, time.Now().Format(time.RFC3339)))
	}

	// 记录审计日志
	go s.saveAuditLog(req.SessionID, "", "", req.ToolName, req.Params, resultStr, status, execTimeMs)

	// 调用 LLM 生成自然语言总结
	summaryMessage := ""
	if err == nil {
		// 创建临时 session 用于生成总结
		tempSession := llm.NewSession(req.SessionID)
		tempSession.AddMessage("user", "请总结以下工具执行结果，用自然语言描述：")
		tempSession.AddMessage("tool", resultStr)

		summaryResp, summaryErr := s.llm.ChatSimple(context.Background(), tempSession.Messages)
		if summaryErr == nil && len(summaryResp.Choices) > 0 {
			summaryMessage = summaryResp.Choices[0].Message.Content
		}
	}

	// 如果没有总结，使用原始结果
	if summaryMessage == "" {
		summaryMessage = resultStr
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"status":  "executed",
		"result":  result,
		"message": summaryMessage,
	})
}

// HandleAITools handles list tools request
func (s *AIService) HandleAITools(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	tools := s.registry.ListTools()

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"tools": tools,
	})
}

// HandleAIChatHistory handles getting chat history
func (s *AIService) HandleAIChatHistory(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	sessionID := r.URL.Query().Get("session_id")
	if sessionID == "" {
		http.Error(w, "session_id required", http.StatusBadRequest)
		return
	}

	s.sessionsMu.RLock()
	session, ok := s.sessions[sessionID]
	s.sessionsMu.RUnlock()

	if !ok {
		http.Error(w, "Session not found", http.StatusNotFound)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"session_id": sessionID,
		"messages":   session.Messages,
	})
}

// HandleAILogs handles SSE for streaming execution logs
func (s *AIService) HandleAILogs(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	sessionID := r.URL.Query().Get("session_id")
	if sessionID == "" {
		http.Error(w, "session_id required", http.StatusBadRequest)
		return
	}

	// Set SSE headers
	w.Header().Set("Content-Type", "text/event-stream")
	w.Header().Set("Cache-Control", "no-cache")
	w.Header().Set("Connection", "keep-alive")
	w.Header().Set("Access-Control-Allow-Origin", "*")

	// Subscribe to log channel
	ch := logBroadcaster.Subscribe(sessionID)
	defer logBroadcaster.Unsubscribe(sessionID)

	// Send initial connection message
	fmt.Fprintf(w, "data: {\"status\": \"connected\", \"session_id\": \"%s\"}\n\n", sessionID)
	if flusher, ok := w.(http.Flusher); ok {
		flusher.Flush()
	}

	// Keep connection open and send logs
	ticker := time.NewTicker(30 * time.Second)
	defer ticker.Stop()

	for {
		select {
		case log, ok := <-ch:
			if !ok {
				return
			}
			fmt.Fprintf(w, "data: %s\n\n", log)
			if flusher, ok := w.(http.Flusher); ok {
				flusher.Flush()
			}
		case <-ticker.C:
			// Send keepalive
			fmt.Fprintf(w, ": keepalive\n\n")
			if flusher, ok := w.(http.Flusher); ok {
				flusher.Flush()
			}
		case <-r.Context().Done():
			return
		}
	}
}

func (s *AIService) getOrCreateSession(id string) *llm.Session {
	s.sessionsMu.Lock()
	defer s.sessionsMu.Unlock()

	session, ok := s.sessions[id]
	if !ok {
		session = llm.NewSession(id)
		s.sessions[id] = session
	}
	return session
}

func convertMCPToLLMTools(mcpTools []mcp.Tool) []llm.Tool {
	tools := make([]llm.Tool, len(mcpTools))
	for i, t := range mcpTools {
		tools[i] = llm.Tool{
			Type: "function",
			Function: llm.FunctionDefinition{
				Name:        t.Name,
				Description: t.Description,
				Parameters:  convertInputSchema(t.InputSchema),
			},
		}
	}
	return tools
}

func convertInputSchema(schema mcp.InputSchema) map[string]interface{} {
	// Convert properties map to map[string]interface{}
	props := make(map[string]interface{})
	for k, v := range schema.Properties {
		prop := map[string]interface{}{
			"type":        v.Type,
			"description": v.Description,
		}
		if len(v.Enum) > 0 {
			prop["enum"] = v.Enum
		}
		if v.Minimum != nil {
			prop["minimum"] = *v.Minimum
		}
		if v.Maximum != nil {
			prop["maximum"] = *v.Maximum
		}
		props[k] = prop
	}

	result := map[string]interface{}{
		"type":       schema.Type,
		"properties": props,
	}
	// Only add required if it has values and is not nil
	// Note: Empty slice []string{} serializes as null, so we must check for nil
	if schema.Required != nil && len(schema.Required) > 0 {
		result["required"] = schema.Required
	}
	return result
}

func generateSessionID() string {
	return fmt.Sprintf("session-%d", time.Now().UnixNano())
}

func toJSON(v interface{}) string {
	data, _ := json.Marshal(v)
	return string(data)
}

// saveAuditLog saves AI audit log asynchronously
func (s *AIService) saveAuditLog(sessionID, userMessage, aiResponse, toolName string, toolArgs map[string]interface{}, toolResult, toolStatus string, execTimeMs int) {
	if s.store == nil {
		return
	}
	log := &controllerstorage.AIAuditLog{
		SessionID:       sessionID,
		UserMessage:     userMessage,
		AIResponse:      aiResponse,
		ToolName:        toolName,
		ToolArguments:   toolArgs,
		ToolResult:      toolResult,
		ToolStatus:      toolStatus,
		ExecutionTimeMs: execTimeMs,
		CreatedAt:       time.Now(),
	}
	if err := s.store.SaveAIAuditLog(log); err != nil {
		s.logger.Error("Failed to save AI audit log: %v", err)
	}
}
