    },
    UnblockDstIp {
        #[arg(short, long)]
        ip: String,
    },
    BlockPort {
        #[arg(short, long)]
        port: u16,
    },
    UnblockPort {
        #[arg(short, long)]
        port: u16,
    },
    Allow {
        #[arg(long)]
        src_ip: Option<String>,
        #[arg(long)]
        dst_ip: Option<String>,
        #[arg(long)]
        src_port: u16,
        #[arg(long)]
        dst_port: u16,
        #[arg(long, default_value = "6")]
        protocol: u8,
    },
    Deny {
        #[arg(long)]
        src_ip: Option<String>,
        #[arg(long)]
        dst_ip: Option<String>,
        #[arg(long)]
        src_port: u16,
        #[arg(long)]
        dst_port: u16,
        #[arg(long, default_value = "6")]
        protocol: u8,
    },
    RemoveRule {
        #[arg(long)]
        src_ip: Option<String>,
        #[arg(long)]
        dst_ip: Option<String>,
        #[arg(long)]
        src_port: u16,
        #[arg(long)]
        dst_port: u16,
        #[arg(long, default_value = "6")]
        protocol: u8,
    },
    Stats {
        #[arg(long)]
