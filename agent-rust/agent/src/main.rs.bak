        ip: String,
    },
    RemovePeer {
        #[arg(long)]
        src_ip: String,
        #[arg(long)]
        dst_ip: String,
    },
    RemoveService {
        #[arg(long)]
        src_ip: Option<String>,
        #[arg(long)]
        dst_ip: Option<String>,
        #[arg(long)]
        src_port: u16,
        #[arg(long)]
        dst_port: u16,
        #[arg(long, default_value = "6")]
        protocol: u8,
    },
    StatsIp {
        #[arg(short, long)]
        ip: String,
    },
    StatsPeer {
        #[arg(long)]
        src_ip: String,
        #[arg(long)]
        dst_ip: String,
    },
    StatsService {
        #[arg(long)]
        src_ip: Option<String>,
        #[arg(long)]
        dst_ip: Option<String>,
        #[arg(long)]
        src_port: u16,
        #[arg(long)]
        dst_port: u16,
        #[arg(long, default_value = "6")]
        protocol: u8,
    },
}

