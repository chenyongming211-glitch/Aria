[Unit]
Description=SD-WAN Controller - Mesh Network Control Plane
Documentation=https://github.com/example/aria
After=network-online.target postgresql.service redis.service
Wants=network-online.target
Requires=network-online.target

[Service]
Type=simple
User=aria
Group=aria

# Environment file for configuration
EnvironmentFile=-/etc/aria/controller.env

# Main process
ExecStart=/usr/local/bin/aria-controller \
    --pg-host=${PG_HOST} \
    --pg-port=${PG_PORT:-5432} \
    --pg-user=${PG_USER} \
    --pg-password=${PG_PASSWORD} \
    --pg-database=${PG_DATABASE:-aria} \
    --redis-addr=${REDIS_ADDR} \
    --redis-password=${REDIS_PASSWORD} \
    --base-ip=${BASE_IP:-100.64.0.0} \
    --cidr=${CIDR:-100.64.0.0/16} \
    --port=${PORT:-8080} \
    --log-dir=/var/log/aria \
    --log-level=${LOG_LEVEL:-info}

# Graceful shutdown
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30

# Restart configuration
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/aria
PrivateTmp=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aria-controller

[Install]
WantedBy=multi-user.target
