[Unit]
Description=SD-WAN Agent - WireGuard Mesh Network Agent
Documentation=https://github.com/example/aria
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Environment file for configuration
EnvironmentFile=-/etc/aria/agent.env

# Main process
ExecStart=/usr/local/bin/aria-agent \
    --controller=${CONTROLLER_URL} \
    --log-dir=/var/log/aria \
    --log-level=${LOG_LEVEL:-info} \
    --data-dir=/var/lib/aria

# Graceful shutdown
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30

# Restart configuration - Critical for OTA updates
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/aria /var/lib/aria /etc/wireguard
PrivateTmp=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aria-agent

[Install]
WantedBy=multi-user.target
