          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "Time Since Last Handshake",
              "endpoint": "Endpoint",
              "public_key": "Public Key"
            }
          }
        }
