# Aria Agent Configuration
# Generated by Ansible
# Region: {{ aria_region }}

controller_url: https://{{ aria_controller_domain }}:{{ aria_controller_grpc_port }}
ca_cert: {{ vault_ca_cert_path }}
client_cert: {{ vault_agent_cert_path }}/agent-{{ aria_region }}.crt
client_key: {{ vault_agent_key_path }}/agent-{{ aria_region }}.key
device_id: null
private_key: {{ aria_private_key | default(omit) }}
public_key: {{ aria_public_key | default(omit) }}
assigned_ip: "{{ aria_agent_ip_pool[aria_region] | default('100.64.0.0') }}"
address: "{{ aria_agent_ip_pool[aria_region] | default('100.64.0.0') }}/32"
interface_name: {{ aria_agent_defaults.interface_name }}
listen_port: {{ aria_agent_defaults.listen_port }}
mtu: {{ aria_agent_defaults.mtu }}
region: {{ aria_region }}
customer_id: null
advertised_routes: null
hostname: null
sync_interval: {{ aria_agent_defaults.sync_interval }}
multi_tunnel: {{ aria_agent_defaults.multi_tunnel | lower }}
