# Aria Controller Docker Compose
# Generated by Ansible. Keep this shape aligned with docs/deployment.md.

services:
  aria-frontend:
    image: nginx:1.27-alpine
    container_name: aria-frontend
    restart: unless-stopped
    ports:
      - "18080:80"
    volumes:
      - ./frontend/dist:/usr/share/nginx/html:ro
      - ./frontend/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      aria-controller:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s
    networks:
      - aria-controller-net

  aria-controller:
    image: {{ aria_controller_image | default('ghcr.io/chenyongming211-glitch/aria-controller:0.2.35-test') }}
    container_name: aria-controller
    restart: unless-stopped
    command: ["controller", "serve", "--config=/etc/aria/controller.yaml"]
    env_file:
      - .env
    ports:
      - "{{ aria_controller_grpc_port | default(50051) }}:50051"
    volumes:
      - ./config/controller.yaml:/etc/aria/controller.yaml:ro
      - ./certs:/etc/aria/certs:ro
      - ./logs:/var/log/aria
      - ./data/backups:/opt/aria/data/backups
      - ./artifacts:/root/aria-controller/artifacts:ro
    depends_on:
      aria-postgres:
        condition: service_healthy
      aria-redis:
        condition: service_healthy
      aria-victoriametrics:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/api/version >/dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    networks:
      - aria-controller-net

  aria-postgres:
    image: postgres:16-alpine
    container_name: aria-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: aria
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: aria
    ports:
      - "127.0.0.1:15432:5432"
    volumes:
      - aria-controller-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U aria -d aria"]
      interval: 5s
      timeout: 5s
      retries: 20
    networks:
      - aria-controller-net

  aria-redis:
    image: redis:7-alpine
    container_name: aria-redis
    restart: unless-stopped
    ports:
      - "127.0.0.1:16379:6379"
    volumes:
      - aria-controller-redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 20
    networks:
      - aria-controller-net

  aria-victoriametrics:
    image: victoriametrics/victoria-metrics:latest
    container_name: aria-victoriametrics
    restart: unless-stopped
    command:
      - "--storageDataPath=/victoria-metrics-data"
      - "--retentionPeriod=30d"
    ports:
      - "127.0.0.1:18428:8428"
    volumes:
      - aria-controller-vmdata:/victoria-metrics-data
    networks:
      - aria-controller-net

volumes:
  aria-controller-pgdata:
  aria-controller-redisdata:
  aria-controller-vmdata:

networks:
  aria-controller-net:
    name: aria-controller-net
