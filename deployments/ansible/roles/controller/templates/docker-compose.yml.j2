# Aria Controller Docker Compose
# 使用: docker compose up -d

version: '3.8'

services:
  aria-postgres:
    image: postgres:16-alpine
    container_name: aria-postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-aria}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-aria-local-password}
      POSTGRES_DB: ${POSTGRES_DATABASE:-aria}
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    networks:
      - aria_shared_net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-aria} -d ${POSTGRES_DATABASE:-aria}"]
      interval: 5s
      timeout: 5s
      retries: 5

  aria-redis:
    image: redis:7-alpine
    container_name: aria-redis
    restart: unless-stopped
    networks:
      - aria_shared_net

  aria-victoriametrics:
    image: victoriametrics/victoria-metrics:latest
    container_name: aria-victoriametrics
    volumes:
      - vmdata:/victoria-metrics-data
    restart: unless-stopped
    networks:
      - aria_shared_net

  aria-controller:
    image: aria-controller:latest
    container_name: aria_controller
    depends_on:
      - aria-postgres
      - aria-redis
      - aria-victoriametrics
    restart: unless-stopped
    user: "root"
    volumes:
      - ./config/controller.yaml:/etc/aria/controller.yaml:ro
      - ./certs:/etc/aria/certs:ro
    environment:
      - POSTGRES_HOST=${POSTGRES_HOST:-aria-postgres}
      - POSTGRES_PORT=${POSTGRES_PORT:-5432}
      - POSTGRES_USER=${POSTGRES_USER:-aria}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-aria-local-password}
      - POSTGRES_DATABASE=${POSTGRES_DATABASE:-aria}
      - REDIS_ADDR=${REDIS_ADDR:-aria-redis:6379}
      - ARIA_GRPC_TLS_MODE=${ARIA_GRPC_TLS_MODE:-disabled}
      - ARIA_GRPC_SERVER_CERT=${ARIA_GRPC_SERVER_CERT:-/etc/aria/certs/grpc-server.crt}
      - ARIA_GRPC_SERVER_KEY=${ARIA_GRPC_SERVER_KEY:-/etc/aria/certs/grpc-server.key}
      - ARIA_GRPC_CA_CERT=${ARIA_GRPC_CA_CERT:-/etc/aria/certs/ca.crt}
      - DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
      - DEEPSEEK_BASE_URL=${DEEPSEEK_BASE_URL:-https://api.deepseek.com}
      - DEEPSEEK_MODEL=${DEEPSEEK_MODEL:-deepseek-chat}
      - FEISHU_APP_ID=${FEISHU_APP_ID}
      - FEISHU_APP_SECRET=${FEISHU_APP_SECRET}
      - FEISHU_ENCRYPT_KEY=${FEISHU_ENCRYPT_KEY:-}
      - FEISHU_VERIFY_TOKEN=${FEISHU_VERIFY_TOKEN}
    ports:
      - "50051:50051"
    networks:
      - aria_shared_net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/version"]
      interval: 30s
      timeout: 10s
      retries: 3
    command: ["controller", "serve", "--config=/etc/aria/controller.yaml"]

  aria-web:
    image: nginx:alpine
    container_name: aria-web
    depends_on:
      - aria-controller
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./ui-dist:/usr/share/nginx/html:ro
      - ./nginx/certs:/etc/nginx/certs:ro
    ports:
      - "443:443"
      - "80:80"
    restart: unless-stopped
    networks:
      - aria_shared_net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3

volumes:
  pgdata:
  vmdata:

networks:
  aria_shared_net:
    name: aria_shared_net
    external: true
