-- =====================================================
-- Aria Controller 数据库初始化脚本
-- 使用方式: docker exec aria_postgres psql -U aria -d aria -f /init-db.sql
-- =====================================================

-- -------------------- 租户表 --------------------
CREATE TABLE IF NOT EXISTS tenants (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100) NOT NULL,
    created_at TIMESTAMPTZ DEFAULT now(),
    code VARCHAR(50),
    status VARCHAR(20) DEFAULT 'active',
    resource_quota JSONB
);

-- 创建默认租户
INSERT INTO tenants (id, name, code, status) 
VALUES ('00000000-0000-0000-0000-000000000001', 'default', 'default', 'active')
ON CONFLICT (id) DO NOTHING;

-- -------------------- Token表 --------------------
CREATE TABLE IF NOT EXISTS tokens (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    token VARCHAR(64) NOT NULL UNIQUE,
    tag VARCHAR(128),
    max_uses INTEGER NOT NULL DEFAULT 1,
    used_count INTEGER NOT NULL DEFAULT 0,
    expires_at TIMESTAMP NOT NULL DEFAULT (now() + INTERVAL '1 year'),
    created_at TIMESTAMP DEFAULT now(),
    created_by VARCHAR(64),
    status VARCHAR(16) DEFAULT 'active',
    last_used_at TIMESTAMP,
    last_used_by VARCHAR(64),
    tenant_id UUID REFERENCES tenants(id)
);

CREATE INDEX IF NOT EXISTS idx_tokens_token ON tokens(token);
CREATE INDEX IF NOT EXISTS idx_tokens_status ON tokens(status);
CREATE INDEX IF NOT EXISTS idx_tokens_expires_at ON tokens(expires_at);

-- -------------------- 节点表 --------------------
CREATE TABLE IF NOT EXISTS nodes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    public_key VARCHAR(44) NOT NULL UNIQUE,
    machine_id VARCHAR(100) NOT NULL,
    tenant_id UUID REFERENCES tenants(id),
    endpoint VARCHAR(100),
    private_ip VARCHAR(45),
    public_ip VARCHAR(45),
    region VARCHAR(50),
    vpc_id VARCHAR(50),
    hostname VARCHAR(100),
    assigned_ip INET,
    ip_offset INTEGER NOT NULL DEFAULT 0,
    last_seen BIGINT NOT NULL,
    registered_at BIGINT NOT NULL,
    role VARCHAR(20) DEFAULT 'spoke',
    runtime_mode VARCHAR(16) DEFAULT 'kernel',
    kernel_version VARCHAR(32),
    has_aesni BOOLEAN DEFAULT false,
    status VARCHAR(20) DEFAULT 'online',
    offline_since BIGINT,
    enrolled_with_token VARCHAR(64),
    advertised_routes TEXT[],
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_nodes_public_key ON nodes(public_key);
CREATE INDEX IF NOT EXISTS idx_nodes_status ON nodes(status);
CREATE INDEX IF NOT EXISTS idx_nodes_last_seen ON nodes(last_seen);
CREATE INDEX IF NOT EXISTS idx_nodes_runtime_mode ON nodes(runtime_mode);
CREATE INDEX IF NOT EXISTS idx_nodes_tenant_id ON nodes(tenant_id);

-- -------------------- IP池表 --------------------
CREATE TABLE IF NOT EXISTS ip_pools (
    id SERIAL PRIMARY KEY,
    tenant_id UUID REFERENCES tenants(id),
    cidr CIDR NOT NULL,
    current_offset INTEGER DEFAULT 1,
    is_active BOOLEAN DEFAULT true,
    UNIQUE(tenant_id, cidr)
);

-- 创建默认IP池
INSERT INTO ip_pools (tenant_id, cidr, is_active) 
VALUES ('00000000-0000-0000-0000-000000000001', '100.64.0.0/16', true)
ON CONFLICT DO NOTHING;

-- -------------------- IP分配表 --------------------
CREATE TABLE IF NOT EXISTS ip_allocations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    node_id UUID REFERENCES nodes(id) ON DELETE CASCADE,
    pool_id INTEGER REFERENCES ip_pools(id),
    ip INET NOT NULL,
    allocated_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_ip_allocations_node_id ON ip_allocations(node_id);
CREATE INDEX IF NOT EXISTS idx_ip_allocations_ip ON ip_allocations(ip);

-- -------------------- ACL规则表 --------------------
CREATE TABLE IF NOT EXISTS acl_rules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id),
    name VARCHAR(100),
    priority INTEGER DEFAULT 100,
    action VARCHAR(20) NOT NULL,  -- allow, deny
    src_ip CIDR,
    dst_ip CIDR,
    src_port VARCHAR(50),
    dst_port VARCHAR(50),
    protocol VARCHAR(20),
    direction VARCHAR(20) DEFAULT 'ingress',  -- ingress, egress
    enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_acl_rules_tenant_id ON acl_rules(tenant_id);

-- -------------------- 带宽限制表 --------------------
CREATE TABLE IF NOT EXISTS bandwidth_limits (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id),
    name VARCHAR(100),
    target_type VARCHAR(20) NOT NULL,  -- node, service, ip
    target_id VARCHAR(100),
    bandwidth_mbps INTEGER NOT NULL,
    priority INTEGER DEFAULT 100,
    enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_bandwidth_limits_tenant_id ON bandwidth_limits(tenant_id);

-- -------------------- 策略规则表 --------------------
CREATE TABLE IF NOT EXISTS policy_rules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id),
    name VARCHAR(100),
    priority INTEGER DEFAULT 100,
    action VARCHAR(20) NOT NULL,
    conditions JSONB,
    actions JSONB,
    enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_policy_rules_tenant_id ON policy_rules(tenant_id);

-- -------------------- 设备配置表 --------------------
CREATE TABLE IF NOT EXISTS device_configs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    node_id UUID REFERENCES nodes(id) ON DELETE CASCADE,
    config_key VARCHAR(100) NOT NULL,
    config_value TEXT,
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_device_configs_node_id ON device_configs(node_id);

-- -------------------- 隧道连接表 --------------------
CREATE TABLE IF NOT EXISTS tunnel_links (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    src_node_id UUID REFERENCES nodes(id) ON DELETE CASCADE,
    dst_node_id UUID REFERENCES nodes(id) ON DELETE CASCADE,
    tunnel_ip INET,
    status VARCHAR(20) DEFAULT 'active',
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_tunnel_links_src ON tunnel_links(src_node_id);
CREATE INDEX IF NOT EXISTS idx_tunnel_links_dst ON tunnel_links(dst_node_id);

-- -------------------- 状态表 --------------------
CREATE TABLE IF NOT EXISTS state (
    key VARCHAR(100) PRIMARY KEY,
    value TEXT,
    updated_at TIMESTAMPTZ DEFAULT now()
);

-- -------------------- 用户表 --------------------
CREATE TABLE IF NOT EXISTS users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id),
    username VARCHAR(100) NOT NULL,
    email VARCHAR(255),
    password_hash VARCHAR(255),
    role VARCHAR(20) DEFAULT 'user',
    status VARCHAR(20) DEFAULT 'active',
    created_at TIMESTAMPTZ DEFAULT now(),
    last_login_at TIMESTAMPTZ
);

CREATE INDEX IF NOT EXISTS idx_users_tenant_id ON users(tenant_id);
CREATE INDEX IF NOT EXISTS idx_users_username ON users(username);

-- -------------------- AI审计日志表 --------------------
CREATE TABLE IF NOT EXISTS ai_audit_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id),
    user_id UUID,
    prompt TEXT,
    response TEXT,
    model VARCHAR(50),
    tokens_used INTEGER,
    latency_ms INTEGER,
    status VARCHAR(20),
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_ai_audit_logs_tenant_id ON ai_audit_logs(tenant_id);
CREATE INDEX IF NOT EXISTS idx_ai_audit_logs_created_at ON ai_audit_logs(created_at);

-- 授予权限
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO aria;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO aria;

-- 初始化完成
DO $$
BEGIN
    RAISE NOTICE 'Database initialized successfully!';
END $$;
