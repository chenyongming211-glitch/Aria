# Aria Controller Environment Configuration
# Generated by Ansible

# -------------------- 数据库配置 --------------------
POSTGRES_HOST={{ vault_postgres_host }}
POSTGRES_PORT={{ vault_postgres_port }}
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DATABASE={{ vault_postgres_database }}
POSTGRES_SSLMODE=disable

# -------------------- Redis --------------------
REDIS_ADDR={{ vault_redis_addr }}
REDIS_PASSWORD={{ vault_redis_password }}

# -------------------- gRPC TLS 配置 --------------------
ARIA_GRPC_TLS_MODE={{ aria_grpc_tls_mode }}
ARIA_GRPC_SERVER_CERT={{ aria_grpc_server_cert }}
ARIA_GRPC_SERVER_KEY={{ aria_grpc_server_key }}
ARIA_GRPC_CA_CERT={{ aria_grpc_ca_cert }}

# -------------------- DeepSeek AI --------------------
DEEPSEEK_API_KEY={{ vault_deepseek_api_key }}
DEEPSEEK_BASE_URL={{ vault_deepseek_base_url }}
DEEPSEEK_MODEL={{ vault_deepseek_model }}
DEEPSEEK_SYSTEM_PROMPT={{ vault_deepseek_system_prompt }}

# -------------------- 飞书 --------------------
FEISHU_APP_ID={{ vault_feishu_app_id }}
FEISHU_APP_SECRET={{ vault_feishu_app_secret }}
FEISHU_ENCRYPT_KEY={{ vault_feishu_encrypt_key }}
FEISHU_VERIFY_TOKEN={{ vault_feishu_verify_token }}
