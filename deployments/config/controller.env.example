# SD-WAN Controller Environment Configuration
# Copy this file to /etc/aria/controller.env and modify as needed

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_password
PG_DATABASE=aria

# Redis Configuration (optional but recommended)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Network Configuration
BASE_IP=100.64.0.0
CIDR=100.64.0.0/16

# Server Configuration
PORT=8080

# Logging
LOG_LEVEL=info
