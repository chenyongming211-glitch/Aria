# Aria Web UI Dockerfile
# Nginx with embedded UI files

FROM nginx:alpine

# Copy UI files
COPY deployments/controller-web/ui-dist/ /usr/share/nginx/html/

# Copy nginx config
COPY deployments/controller-web/nginx/default.conf /etc/nginx/conf.d/default.conf

# Create certs directory
RUN mkdir -p /etc/nginx/certs

EXPOSE 443

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsk https://localhost/health || exit 1
