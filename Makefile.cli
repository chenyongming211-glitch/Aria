# Makefile for aria-cli

.PHONY: build clean test

# Build the aria-cli binary
build:
	go build -o bin/aria-cli ./cmd/aria-cli

# Clean build artifacts
clean:
	rm -rf bin/

# Build for Linux AMD64 (similar to other aria binaries)
build-linux-amd64:
	GOOS=linux GOARCH=amd64 go build -o bin/aria-cli-linux-amd64 ./cmd/aria-cli

# Test the application
test:
	go test ./cmd/aria-cli/...

# Install dependencies
deps:
	go mod tidy